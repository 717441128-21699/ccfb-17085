{
  "name": "diabolo-harmony-station",
  "version": "1.0.0",
  "private": true,
  "description": "空竹哨音实时跟踪 / 和弦拉音 / 和声 / 拍点效果 / 演出录制工作台",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 47917",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 47918",
    "typecheck": "tsc --noEmit",
    "verify:worklet": "node scripts/verify-worklet.mjs",
    "soak": "node scripts/verify-worklet.mjs --soak",
    "verify:browser": "npm run build && node scripts/browser-selftest.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^24.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
